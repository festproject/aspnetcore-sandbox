@{
    ViewData["Title"] = "Page expired";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="display-6">This page is no longer valid</h1>
        <p class="text-muted">
            Your session may have changed or the page may have expired. No changes were made.
        </p>
        <a class="btn btn-primary" asp-controller="Stateful" asp-action="PageStateDemo">Start over</a>
    </div>
</div>
