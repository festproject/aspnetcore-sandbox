@{
    ViewData["Title"] = "Page expired";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="display-6">This page has expired</h1>
        <p class="text-muted">
            The form was submitted with a page state token that was missing, tampered with, or has
            expired. No changes were made.
        </p>
        <a class="btn btn-primary" asp-controller="Stateful" asp-action="PageStateDemo">Start over</a>
    </div>
</div>
