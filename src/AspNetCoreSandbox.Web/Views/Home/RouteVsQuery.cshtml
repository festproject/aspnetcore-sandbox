@{
    ViewData["Title"] = "Route vs Query lab";
    var boundName = ViewData["BoundName"]?.ToString();
    var routeName = ViewData["RouteName"]?.ToString();
    var queryName = ViewData["QueryName"]?.ToString();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="display-6 mb-3">Route vs Query lab</h1>
        <p class="text-muted">
            Compare route value and query value with the same key <code>name</code>.
        </p>

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h5">Current request</h2>
                <pre class="mb-0">Bound name=[@boundName]
Route name=[@routeName]
Query name=[@queryName]</pre>
            </div>
        </div>

        <div class="small text-muted">
            <p class="mb-1">Try this URL:</p>
            <code>/Home/RouteVsQuery/RouteName?name=QueryName</code>
        </div>
    </div>
</div>
