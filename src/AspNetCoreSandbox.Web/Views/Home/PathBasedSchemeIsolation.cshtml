@{
    ViewData["Title"] = "Path-based scheme isolation";

    var currentPath = ViewData["CurrentPath"] as string ?? string.Empty;
    var currentUserName = ViewData["CurrentUserName"] as string ?? "(anonymous)";
    var isAuthenticated = ViewData["IsAuthenticated"] as string ?? "false";
    var siteScheme = ViewData["SiteScheme"] as string ?? string.Empty;
    var adminScheme = ViewData["AdminScheme"] as string ?? string.Empty;
    var siteCookieName = ViewData["SiteCookieName"] as string ?? string.Empty;
    var adminCookieName = ViewData["AdminCookieName"] as string ?? string.Empty;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <h1 class="h3 mb-3">Path-based multi-scheme isolation</h1>
        <p class="text-muted">
            Requests under <code>/admin</code> authenticate with the admin cookie scheme,
            and non-admin requests authenticate with the site cookie scheme.
            <code>HttpContext.User</code> is selected per request path.
        </p>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5">Current request</h2>
                <pre class="mb-0">Path: @currentPath
HttpContext.User.Name: @currentUserName
HttpContext.User.IsAuthenticated: @isAuthenticated
SiteScheme: @siteScheme (Cookie: @siteCookieName)
AdminScheme: @adminScheme (Cookie: @adminCookieName)</pre>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-3">
            <button type="button" class="btn btn-outline-secondary" id="signOutSiteButton">Sign out site cookie</button>
            <button type="button" class="btn btn-outline-secondary" id="signOutAdminButton">Sign out admin cookie</button>
            <button type="button" class="btn btn-outline-primary" id="signInSiteButton">Sign in site as SiteAlice</button>
            <button type="button" class="btn btn-outline-danger" id="signInAdminButton">Sign in admin as AdminBob</button>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">
            <button type="button" class="btn btn-outline-dark" id="whoamiSiteButton">WhoAmI at /Home path</button>
            <button type="button" class="btn btn-outline-dark" id="whoamiAdminButton">WhoAmI at /admin path</button>
            <a class="btn btn-sm btn-link" href="/Home/PathBasedSchemeIsolation">Open /Home/PathBasedSchemeIsolation</a>
            <a class="btn btn-sm btn-link" href="/admin/scheme-lab">Open /admin/scheme-lab</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Result</h2>
                <pre id="result" class="mb-0">No request sent yet.</pre>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const result = document.getElementById('result');

            function show(status, payload) {
                result.textContent = 'HTTP ' + status + '\n' + JSON.stringify(payload, null, 2);
            }

            async function postForm(url, bodyObj) {
                const body = new URLSearchParams();
                Object.keys(bodyObj).forEach(key => body.set(key, bodyObj[key] ?? ''));
                const response = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: body.toString()
                });
                const payload = await response.json();
                show(response.status, payload);
            }

            async function getJson(url) {
                const response = await fetch(url);
                const payload = await response.json();
                show(response.status, payload);
            }

            document.getElementById('signOutSiteButton').addEventListener('click', async () => {
                await postForm('/Home/PathBasedSchemeIsolation/sign-out-site', {});
            });

            document.getElementById('signOutAdminButton').addEventListener('click', async () => {
                await postForm('/Home/PathBasedSchemeIsolation/sign-out-admin', {});
            });

            document.getElementById('signInSiteButton').addEventListener('click', async () => {
                await postForm('/Home/PathBasedSchemeIsolation/sign-in-site', { username: 'SiteAlice' });
            });

            document.getElementById('signInAdminButton').addEventListener('click', async () => {
                await postForm('/Home/PathBasedSchemeIsolation/sign-in-admin', { username: 'AdminBob' });
            });

            document.getElementById('whoamiSiteButton').addEventListener('click', async () => {
                await getJson('/Home/PathBasedSchemeIsolation/whoami');
            });

            document.getElementById('whoamiAdminButton').addEventListener('click', async () => {
                await getJson('/admin/scheme-lab/whoami');
            });
        })();
    </script>
}
