@{
    ViewData["Title"] = "Form vs Route lab";
    var boundName = ViewData["BoundName"]?.ToString();
    var routeName = ViewData["RouteName"]?.ToString();
    var formName = ViewData["FormName"]?.ToString();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="display-6 mb-3">Form vs Route lab</h1>
        <p class="text-muted">
            Compare route value and form value with the same key <code>name</code>.
        </p>

        @if (ViewData["Message"] is string message)
        {
            <div class="alert alert-success" role="alert">@message</div>
        }

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <form method="post" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="name" class="form-label">Form name</label>
                        <input id="name" name="name" class="form-control" value="FormName" />
                    </div>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h5">Current request</h2>
                <pre class="mb-0">Bound name=[@boundName]
Route name=[@routeName]
Form name=[@formName]</pre>
            </div>
        </div>

        <div class="small text-muted">
            <p class="mb-1">Try this URL:</p>
            <code>/Home/FormVsRoute/RouteName</code>
        </div>
    </div>
</div>
