@{
    ViewData["Title"] = "Failure definitions";
    var requiredOnly = ViewData["RequiredOnly"]?.ToString();
    var bindRequiredOnly = ViewData["BindRequiredOnly"]?.ToString();
    var optional = ViewData["Optional"]?.ToString();
    var requiredOnlyErrors = ViewData["RequiredOnlyErrors"]?.ToString();
    var bindRequiredOnlyErrors = ViewData["BindRequiredOnlyErrors"]?.ToString();
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <h1 class="display-6 mb-3">Failure definitions</h1>
        <p class="text-muted">
            Compare missing values and validation errors using <code>[Required]</code> and
            <code>[BindRequired]</code>.
        </p>

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="h5">Current request</h2>
                <pre class="mb-0">RequiredOnly=[@requiredOnly]
BindRequiredOnly=[@bindRequiredOnly]
Optional=[@optional]

ModelState(RequiredOnly)=[@requiredOnlyErrors]
ModelState(BindRequiredOnly)=[@bindRequiredOnlyErrors]</pre>
            </div>
        </div>

        <div class="small text-muted">
            <p class="mb-1">Try these URLs:</p>
            <div><code>/Home/FailureDefinitions</code></div>
            <div><code>/Home/FailureDefinitions?RequiredOnly=ok</code></div>
            <div><code>/Home/FailureDefinitions?BindRequiredOnly=ok</code></div>
            <div><code>/Home/FailureDefinitions?RequiredOnly=&BindRequiredOnly=</code></div>
        </div>
    </div>
</div>
